# Ejemplo de configuración para E-Paper ACeP 7-Color Smart Dashboard & Mobile Hub
# Copiar a .env y completar con tus credenciales personales:
# cp .env.example .env

VPS_PUBLIC_URL=http://TU_IP_VPS:5050
FLASK_SECRET_KEY=cambiar-por-clave-secreta
FLASK_PORT=5050

# Wi-Fi para Modo Visitas (Código QR en pantalla)
GUEST_WIFI_SSID=MI_WIFI
GUEST_WIFI_PASSWORD=MI_PASSWORD_WIFI
GUEST_WIFI_AUTH=WPA

# Coordenadas para Clima (Open-Meteo)
WEATHER_LATITUDE=-34.6037
WEATHER_LONGITUDE=-58.3816
WEATHER_TIMEZONE=America/Argentina/Buenos_Aires
WEATHER_CACHE_TTL_SEC=900

# Google Calendar (URL secreta en formato iCal .ics)
GOOGLE_CALENDAR_ICAL_URL=

# Tuya OpenAPI (Smart Life / Tuya Smart)
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_API_ENDPOINT=https://openapi.tuyaus.com
TUYA_IRRIGATION_DEVICE_ID=

# Home Assistant (Opcional)
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=
WEBHOOK_BEARER_TOKEN=

# Google Gemini API (para generador de cómics diario)
GEMINI_API_KEY=

# Xiaomi Cloud (para robot aspiradora)
XIAOMI_USERNAME=
XIAOMI_USER_ID=
XIAOMI_PASSWORD=
